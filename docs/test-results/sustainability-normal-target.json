{
  "normal_local_backend_target": "http://127.0.0.1:5000",
  "routes": [
    {
      "source": "/api/:path*",
      "destination": "http://127.0.0.1:5000/api/:path*",
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/health",
      "destination": "http://127.0.0.1:5000/health",
      "regex": "^/health(?:/)?$"
    }
  ],
  "scope": "Build manifest only; a connected backend was not started"
}