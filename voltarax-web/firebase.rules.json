{
  "rules": {
    "readings": {
      "$site": {
        ".indexOn": ["ts"], ".read": false,
        "$reading": {
          ".write": "auth != null && auth.uid === 'PASTE_FIREBASE_DEVICE_UID_HERE' && $site === 'solar_site'",
          ".validate": "newData.hasChildren(['ts', 'site_id', 'device_id']) && newData.child('site_id').val() === $site && newData.child('ts').isNumber()"
        }
      }
    },
    "sites": {
      "$site": {
        "latest": {
          ".read": false,
          ".write": "auth != null && auth.uid === 'PASTE_FIREBASE_DEVICE_UID_HERE' && $site === 'solar_site'",
          ".validate": "newData.child('site_id').val() === $site && newData.child('ts').isNumber()"
        }
      }
    },
    "solar_site": {
      "latest": {
        ".read": false,
        ".write": "auth != null && auth.uid === 'PASTE_FIREBASE_DEVICE_UID_HERE'"
      },
      "history": {
        ".indexOn": ["ts", "site_id"],
        ".read": false,
        ".write": "auth != null && auth.uid === 'PASTE_FIREBASE_DEVICE_UID_HERE'"
      },
      "analysis": {
        ".read": false,
        ".write": false
      },
      "analysis_history": {
        ".read": false,
        ".write": false
      },
      "ai": {
        ".read": false,
        ".write": false
      }
    },
    "users": { ".read": false, ".write": false },
    "content": { ".read": false, ".write": false,
      "subscribers": { ".indexOn": ["email", "isActive"] },
      "posts": { ".indexOn": ["published", "slug", "category", "publishedAt"] }
    }
  }
}
