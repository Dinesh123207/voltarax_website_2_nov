# Node/Express backend used by Next.js server-side API rewrites
# Local: http://127.0.0.1:5000
# GoDaddy: use the local backend process/URL configured by your hosting setup.
BACKEND_URL=http://127.0.0.1:5000

# Public search URLs: unset by default. Use a confirmed HTTPS origin with no path.
# Both switches stay false until publication/legal/content review is complete.
SITE_URL=
PUBLIC_INDEXING_ENABLED=false
PUBLIC_CONTENT_REVIEWED=false

# Optional public contact details shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Optional confirmed public location, not an assumed registered address.
NEXT_PUBLIC_CONTACT_LOCATION=
# Optional reviewed public HTTPS profiles; blank hides each icon.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# Number of configured panels shown in the dashboard (site-derived estimate).
NEXT_PUBLIC_SOLAR_PANEL_COUNT=

# Optional licensed local background video, off until assets are provided/reviewed.
NEXT_PUBLIC_BACKGROUND_VIDEO_ENABLED=false
