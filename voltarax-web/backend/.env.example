# Express listening port.
PORT=5000
# Commerce stays disabled until reviewed test-mode setup. No live mode supported.
PAYMENTS_ENABLED=false
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST tax invoices require a separate reviewed implementation; true blocks checkout.
GST_ENABLED=false
# Runtime environment.
NODE_ENV=production

# Firebase Realtime Database
# Firebase project identifier.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Admin service account email.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Firebase Admin service account private key; keep secret.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Firebase Realtime Database URL.
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
# Alternative: provide the complete service-account JSON as one environment variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JWT used by the GoDaddy backend dashboard session.
# Secret used to sign dashboard sessions.
JWT_SECRET=generate_with_openssl_rand_hex_64
# Allowed frontend origin.
FRONTEND_URL=https://voltarax.in

# Solar configuration
# Site identifier.
SOLAR_SITE_ID=solar_site
# Configured count for site-level estimates.
SOLAR_PANEL_COUNT=
# Panel rated peak power in watts.
SOLAR_PANEL_PMAX_W=10
# Panel temperature coefficient.
SOLAR_TEMP_COEFF=-0.004
# Nominal operating cell temperature in Celsius.
SOLAR_NOCT_C=45
# Baseline performance ratio.
SOLAR_BASELINE_PR=0.75
# Approximate conversion factor from lux to irradiance.
SOLAR_LUX_PER_WM2=120
# Airborne dust alert threshold in micrograms per cubic metre.
SOLAR_DUST_HIGH=150
# Estimated grid emissions in kg per kWh.
GRID_EMISSION_FACTOR=0.82
# Public source or methodology for the configured factor; do not imply official validation.
GRID_EMISSION_FACTOR_SOURCE=Unverified configured assumption
# Optional actual installation tariff; blank makes estimated savings unavailable.
GRID_TARIFF_INR_PER_KWH=
# Optional verified tree conversion methodology; blank makes tree equivalents unavailable.
TREE_CO2_KG_PER_YEAR=

# Maximum age in seconds for AI forecast/anomaly/health output before it is unavailable.
AI_MAX_AGE_SECONDS=7200
AI_MAX_INPUT_AGE_SECONDS=120
AI_MAX_MODEL_AGE_SECONDS=2592000
AI_DAYLIGHT_LUX_THRESHOLD=2000

# Optional HTTP bridge. Direct hardware -> Firebase does not need this.
# Secret key for optional HTTP ingest.
HARDWARE_API_KEY=generate_a_long_random_device_key

# Firebase device UID used in RTDB security rules (set after creating the device auth user).
# Device UID to manually insert into the rules template; not read by the app.
FIREBASE_DEVICE_UID=PASTE_DEVICE_UID_HERE

# Email verification is disabled until an operator explicitly enables real delivery.
EMAIL_ENABLED=false
# SMTP server with TLS, only used when EMAIL_ENABLED=true.
SMTP_HOST=
# TLS port: 465 (implicit TLS) or 587 (STARTTLS required).
SMTP_PORT=587
# SMTP login name; keep local.
SMTP_USER=
# SMTP login secret; never log or commit real credentials.
SMTP_PASS=
# Verified sender address accepted by your provider.
SMTP_FROM=
# Separate random HMAC secret of at least 32 characters for OTP hashes.
OTP_SECRET=
# Cookie/native session lifetime in seconds, 300 to 604800.
SESSION_TTL_SECONDS=28800
# Exact comma-separated frontend origins; overrides FRONTEND_URL if set.
CORS_ORIGINS=
# Trusted reverse-proxy hop count; default 0. Use only with an isolated backend port.
TRUST_PROXY_HOPS=0
# Pino severity (debug, info, warn, error); request bodies are never logged.
LOG_LEVEL=info
# Optional local Redis URL for shared rate limits. A configured unavailable Redis fails closed.
REDIS_URL=
# One-time first-admin setup gate; disable immediately after bootstrap.
BOOTSTRAP_ADMIN_ENABLED=false
# Bootstrap name, email and unique 16+ character password. No defaults.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Primary site-level measurement device used by dashboard/AI; other devices remain in raw history.
SOLAR_DEVICE_ID=nodemcu-01

# Temporary compatibility for the old shared HTTP key; false is the secure default.
ALLOW_LEGACY_DEVICE_KEY=false

# Current dashboard telemetry expiry in seconds; stale measurements remain historical only.
MAX_TELEMETRY_AGE_SECONDS=120

# Relay commands remain disabled until an operator verifies hardware; test mode only during setup.
RELAY_CONTROL_ENABLED=false

# Synthetic ingest gate: requires a non-production localhost demo emulator as well.
DEVICE_SIMULATOR_ENABLED=false
# Test only, leave blank for normal configured Firebase operation; no protocol.
FIREBASE_DATABASE_EMULATOR_HOST=
# Relational features are unavailable until a private PostgreSQL URL is configured.
# Local compose: postgresql://voltarax:URL_ENCODED_PASSWORD@127.0.0.1:15432/voltarax
# On a remote host use TLS with a trusted CA (for example sslmode=verify-full).
DATABASE_URL=
# Explicit migration command only; do not leave enabled in the API process.
ALLOW_RELATIONAL_MIGRATIONS=false
# Notification delivery requires this switch, SMTP, Redis and reviewed recipients.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_RECIPIENTS=
# Legacy audit export import is dry-run unless --apply and this flag are set.
ALLOW_AUDIT_IMPORT=false
# Formal report factor/source must be explicitly verified by an operator.
# The dashboard's unverified assumption is insufficient for formal report generation.
GRID_EMISSION_FACTOR_VERIFIED=false
# Reports require at least 90 percent recorded-power coverage; allow stricter policy only.
ESG_MIN_COVERAGE_PCT=90
# Camera is disabled until an operator configures/validates the private test camera.
# Fixed server-only HTTP(S) URLs, no query/fragment or URL credentials; never NEXT_PUBLIC.
CAMERA_ENABLED=false
CAMERA_STREAM_URL=
CAMERA_SNAPSHOT_URL=
# Optional camera Basic authentication; use a protected LAN or verified HTTPS tunnel.
CAMERA_USERNAME=
CAMERA_PASSWORD=
# Manual categorical indicators expire after this many days (1-365); no numeric score.
INSPECTION_MAX_AGE_DAYS=30
# Boundary source/outline rights and accuracy require operator review; see docs/MAP_DATA.md.
MAP_BOUNDARIES_REVIEWED=false
MAP_BOUNDARY_SHA256=
MAP_BOUNDARY_ATTRIBUTION=
MAP_STATE_PROPERTIES=ST_NM,state
MAP_SITE_STATE=
