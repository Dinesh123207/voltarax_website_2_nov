{
  "name": "voltarax-backend",
  "version": "2.0.0",
  "description": "Voltarax Private Limited — Firebase-backed corporate and solar monitoring API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-voltarax --config ../firebase.test.json \"node --test tests/firebase-rules.test.cjs\"",
    "test:device-emulator": "python ../../tools/run-local-database.py --log docs/test-results/local-device-java.log -- node --test tests/device-emulator.test.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-relational.js"
  },
  "dependencies": {
    "@react-email/render": "2.2.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "6.5.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "0.45.4",
    "express": "^4.18.2",
    "express-rate-limit": "8.7.2",
    "firebase-admin": "^13.5.0",
    "helmet": "^7.1.0",
    "jpeg-js": "0.4.4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pngjs": "7.0.0",
    "rate-limit-redis": "6.0.2",
    "razorpay": "2.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@firebase/rules-unit-testing": "6.0.0",
    "drizzle-kit": "0.31.11",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2",
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
