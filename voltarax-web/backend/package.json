{
  "name": "voltarax-backend",
  "version": "2.0.0",
  "description": "Voltarax Private Limited \u2014 Firebase-backed corporate and solar monitoring API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-voltarax --config ../firebase.test.json \"node --test tests/firebase-rules.test.cjs\""
  },
  "dependencies": {
    "@react-email/render": "2.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "8.7.2",
    "firebase-admin": "^13.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "rate-limit-redis": "6.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2",
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
