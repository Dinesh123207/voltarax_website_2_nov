# Network reads and publication are disabled until explicitly configured by an operator.
AI_REMOTE_ACCESS_ENABLED=false
AI_PUBLISH_ENABLED=false
AI_MAX_INPUT_AGE_SECONDS=120
AI_MAX_MODEL_AGE_SECONDS=2592000
# Reads bounded /readings/{site}, publishes /sites/{site}/ai/*.
# Legacy /solar_site/history is read only for the default solar_site.
# Realtime Database URL.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Local service-account JSON path; never commit the key.
FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccountKey.json
# Alternative to the file above: paste the whole JSON as one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Site to read and publish; letters, digits, underscores or hyphens.
SOLAR_SITE_ID=solar_site
# Rated panel peak power in watts.
SOLAR_PANEL_PMAX_W=10
# Temperature coefficient per Celsius degree.
SOLAR_TEMP_COEFF=-0.004
# Nominal operating cell temperature in Celsius.
SOLAR_NOCT_C=45
# Estimated conversion factor from lux to irradiance.
SOLAR_LUX_PER_WM2=120

# Optional overrides — see config.py for what each one gates.
# AI_MIN_ROWS_ANOMALY=500
# AI_MIN_DAYLIGHT_ROWS_FORECAST=300
# AI_MIN_NEW_ROWS_TO_RETRAIN=100

# Total rows required to train the anomaly detector.
AI_MIN_ROWS_ANOMALY=500
# Daylight rows required to train the power estimator.
AI_MIN_DAYLIGHT_ROWS_FORECAST=300
# Rows required for the healthy-performance baseline.
AI_MIN_ROWS_HEALTH_BASELINE=200
# Lux threshold used to classify daylight.
AI_DAYLIGHT_LUX_THRESHOLD=2000
# Additional rows required before retraining.
AI_MIN_NEW_ROWS_TO_RETRAIN=100
# Maximum per-site history window read into memory.
AI_MAX_HISTORY_ROWS=50000

# Primary site-level measurement device used by dashboard/AI; other devices remain in raw history.
SOLAR_DEVICE_ID=nodemcu-01
